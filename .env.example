# Local development settings. Copy to `.env` (git-ignored) at the repo root:
#
#   cp .env.example .env
#
# The API, the web app, drizzle-kit and the seed script all read this one file.
# NEVER commit `.env` or paste real keys anywhere. Production values live in the
# hosting provider's environment settings, not in files.
# Full reference of every variable: artifacts/api-server/.env.example

# --- Database (local Postgres 16) ---
DATABASE_URL=postgres://lms:lms@localhost:5432/lms

# --- Auth ---
# "dev" = sign in as seeded demo accounts, no Clerk needed (local only; the API
# refuses to start with AUTH_MODE=dev when NODE_ENV=production).
AUTH_MODE=dev
VITE_AUTH_MODE=dev
# For real sign-in instead, remove the two lines above and set your own Clerk keys:
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# ADMIN_EMAILS=you@college.edu

# --- Ports (optional) ---
# API_PORT=8080
# WEB_PORT=5173

# --- Links in emails / invite URLs ---
APP_BASE_URL=http://localhost:5173

# Everything else (object storage, AI grading, MSG91 email) is optional and off
# by default; see artifacts/api-server/.env.example.
